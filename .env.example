SUB2API_DATABASE_URL=postgres://sub2api:replace-with-password@sub2api-postgres:5432/sub2api?sslmode=disable
AUTH_ENABLED=true
LOGIN_PASSWORD=replace-with-dashboard-password
AUTH_SESSION_TTL=168h
APP_PORT=8080
APP_BASE_PATH=
TZ=Asia/Shanghai
WORK_DIR=./data
LOG_LEVEL=info
LOG_FILE_ENABLED=true
LOG_RETENTION_DAYS=7
BACKUP_ENABLED=true
BACKUP_INTERVAL=24h
BACKUP_RETENTION_DAYS=7
REQUEST_TIMEOUT=30s
QUOTA_REFRESH_INTERVAL=5m
PUBLIC_MODE=true
